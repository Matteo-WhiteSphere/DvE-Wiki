rules_version = '2';

// Dragon vs Eagle Wiki — Firestore security rules.
//
// Roles (stored in users/{uid}.role):
//   owner    – created by another owner, the Firebase console or tools/accounts.mjs. Manages admins.
//   admin    – manages editors, creates staff accounts, deletes pages, reads the audit log.
//   editor   – creates and edits wiki pages.
//   user     – signed in, no write access (default for new sign-ins).
//   disabled – blocked account. No write access.
//
// Staff accounts use the "Role.Name" login (e.g. Editor.Rapha). They are e-mail/password
// accounts on the reserved domain below, which can never receive mail, so they count as
// verified. Every other account needs a verified e-mail address.
// Keep STAFF_DOMAIN in sync with USERNAME_DOMAIN in js/firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function staffLoginRe() { return '^[a-z]+[.][a-z0-9_-]+@dve-wiki[.]invalid$'; }

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function realEmailVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function staffLogin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && myEmail().matches(staffLoginRe());
    }
    function verified() { return realEmailVerified() || staffLogin(); }

    function profilePath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function invitePath(email) { return /databases/$(database)/documents/invites/$(email); }

    function hasProfile() { return signedIn() && exists(profilePath(request.auth.uid)); }
    function myProfile() { return get(profilePath(request.auth.uid)).data; }

    // A temporary password must be changed before the account gets any power.
    function active() {
      return verified() && hasProfile() && myProfile().get('mustChangePassword', false) == false;
    }

    function isEditor() { return active() && myProfile().role in ['editor', 'admin', 'owner']; }
    function isAdmin()  { return active() && myProfile().role in ['admin', 'owner']; }
    function isOwner()  { return active() && myProfile().role == 'owner'; }

    // Roles the current user is allowed to grant or take away.
    // Nobody can grant "owner" from the website.
    function canAssign(role) {
      return (isOwner() && role in ['user', 'editor', 'admin', 'disabled'])
          || (isAdmin() && role in ['user', 'editor', 'disabled']);
    }

    // Roles a new "Role.Name" staff account can be created with. Owners can create
    // other owners, but an existing owner can only be changed from the console.
    function canCreateStaff(role) {
      return (isOwner() && role in ['editor', 'admin', 'owner'])
          || (isAdmin() && role == 'editor');
    }

    // Invitations are only for real, verified e-mail addresses (Google or e-mail accounts).
    function hasInviteFor(role) {
      return realEmailVerified()
        && exists(invitePath(myEmail()))
        && get(invitePath(myEmail())).data.role == role;
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if
        // A user creates their own profile on first login: "user", or the role an
        // admin invited their (verified) e-mail address with.
        (signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt', 'lastLogin'])
          && request.resource.data.email == myEmail()
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.createdAt == request.time
          && request.resource.data.lastLogin == request.time
          && (request.resource.data.role == 'user' || hasInviteFor(request.resource.data.role)))
        // An admin creates the profile of a new "Role.Name" staff account.
        || (isAdmin()
          && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt', 'createdBy', 'mustChangePassword'])
          && request.resource.data.email is string
          && request.resource.data.email.matches(staffLoginRe())
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && canCreateStaff(request.resource.data.role)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.mustChangePassword == true);

      allow update: if
        // Self: cosmetic fields, and clearing the "change your password" flag.
        (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lastLogin', 'mustChangePassword'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && (!('mustChangePassword' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.mustChangePassword == false)
          && (!('lastLogin' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.lastLogin == request.time))
        // Self: a plain user that has been invited later picks up the invited role.
        || (signedIn() && request.auth.uid == uid
          && resource.data.role == 'user'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'lastLogin'])
          && request.resource.data.lastLogin == request.time
          && hasInviteFor(request.resource.data.role))
        // Admin / owner: role management, following the hierarchy. Never on yourself.
        || (signedIn() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleUpdatedBy', 'roleUpdatedAt'])
          && canAssign(resource.data.role)
          && canAssign(request.resource.data.role)
          && request.resource.data.roleUpdatedBy == request.auth.uid
          && request.resource.data.roleUpdatedAt == request.time);

      allow delete: if isOwner() && request.auth.uid != uid;
    }

    // -------------------------------------------------------------- invites
    // Document id = lower-case e-mail address.
    match /invites/{email} {
      allow get: if (realEmailVerified() && myEmail() == email) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && email == email.lower()
        && email.matches('^[^@\\s/]+@[^@\\s/]+\\.[^@\\s/]+$')
        && !email.matches(staffLoginRe())
        && request.resource.data.keys().hasOnly(['role', 'method', 'invitedBy', 'createdAt'])
        && request.resource.data.role in ['editor', 'admin']
        && canAssign(request.resource.data.role)
        && request.resource.data.method in ['google', 'password']
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin() || (realEmailVerified() && myEmail() == email);
    }

    // ---------------------------------------------------------------- pages
    match /pages/{slug} {
      function validPage() {
        let d = request.resource.data;
        return slug.matches('^[a-z0-9][a-z0-9_-]{0,63}$')
          && d.keys().hasOnly(['title', 'subtitle', 'category', 'group', 'tag', 'accent', 'navLabel',
                               'navOrder', 'sections', 'published', 'createdBy', 'createdAt',
                               'updatedBy', 'updatedByEmail', 'updatedAt'])
          && d.keys().hasAll(['title', 'subtitle', 'category', 'group', 'tag', 'accent', 'navLabel',
                              'navOrder', 'sections', 'published', 'createdBy', 'createdAt',
                              'updatedBy', 'updatedAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.subtitle is string && d.subtitle.size() <= 200
          && d.category in ['country', 'path', 'guide', 'other']
          && d.group is string && d.group.matches('^[a-z0-9_-]{0,40}$')
          && d.tag is string && d.tag.matches('^[A-Z0-9]{0,4}$')
          && d.accent is string && d.accent.matches('^#[0-9a-fA-F]{6}$')
          && d.navLabel is string && d.navLabel.size() <= 60
          && d.navOrder is int && d.navOrder >= 0 && d.navOrder <= 999
          && d.sections is list && d.sections.size() <= 60
          && d.published is bool
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }

      allow get: if resource == null || resource.data.published == true || isEditor();
      allow list: if resource.data.published == true || isEditor();

      allow create: if isEditor() && validPage()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isEditor() && validPage()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      // Editors can unpublish; only admins can delete.
      allow delete: if isAdmin();

      // Immutable history of every save.
      match /revisions/{revId} {
        allow read: if isEditor();
        allow create: if isEditor()
          && request.resource.data.savedBy == request.auth.uid
          && request.resource.data.savedAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------------------ audit log
    // Append-only. Nobody can edit or delete entries from the website.
    match /audit/{entryId} {
      allow read: if isAdmin();
      allow create: if isEditor()
        && request.resource.data.keys().hasOnly(['action', 'target', 'actor', 'actorEmail', 'at', 'details'])
        && request.resource.data.action is string && request.resource.data.action.size() <= 40
        && request.resource.data.target is string && request.resource.data.target.size() <= 200
        && request.resource.data.details is string && request.resource.data.details.size() <= 500
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.actorEmail == myEmail()
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
